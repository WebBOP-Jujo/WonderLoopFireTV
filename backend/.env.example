# WonderLoop Backend Environment Configuration
PORT=3000
NODE_ENV=production

# Google Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# RevenueCat Secret API Key (from RevenueCat Project Settings -> API Keys)
REVENUECAT_SECRET_KEY=

# Internal Application Secret Key (for mobile app header validation)
APP_SECRET_KEY=change-me-to-a-long-random-secret

