# WonderLoop TV Backend Environment Configuration
PORT=3000
NODE_ENV=production

# Google Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# RevenueCat Secret API Key (optional; leave empty for unlimited hackathon mode)
REVENUECAT_SECRET_KEY=

# REQUIRED. Shared key the Fire TV app sends in the X-WonderLoop-Key header (min. 32 chars).
# The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put the same value in the project's local.properties as: wonderloop.appKey=<value>
APP_SECRET_KEY=

# Number of reverse-proxy hops in front of the server (Caddy, load balancer...). Use 1 when deployed
# behind a proxy so rate limiting sees the real client IP. Leave 0 on a bare LAN server.
TRUST_PROXY=0

# Optional overrides for the QR upload link
# LAN_IP=192.168.1.50
# PUBLIC_BASE_URL=https://api.example.com
